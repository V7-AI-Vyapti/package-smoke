# Deploy build for package-smoke.
# Takes precedence over repo-root .dockerignore, which excludes all of generated/*.

node_modules
.pnpm-store
.turbo
dist
build
.env
.env.*
.git
.gitignore

# Keep other runtime-generated apps out of the build context.
generated/*
!generated/package-smoke/
!generated/package-smoke/**

# Exclude heavy artifacts inside generated projects.
generated/**/node_modules
generated/**/dist
generated/**/.turbo
generated/**/tmp
